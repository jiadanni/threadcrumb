# ThreadCrumb Environment Variables
# Copy this file to .env and fill in your values

# ===== Slack Configuration =====
SLACK_CLIENT_ID=your-client-id
SLACK_CLIENT_SECRET=your-client-secret
SLACK_ACCESS_TOKEN=xoxb-your-bot-token

# ===== AWS Configuration (for Bedrock AI) =====
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_PROFILE=default

# ===== AI Configuration =====
# Model options:
# - anthropic.claude-3-sonnet-20240229-v1:0 (balanced)
# - anthropic.claude-3-haiku-20240307-v1:0 (fast & cheap)
# - anthropic.claude-3-opus-20240229-v1:0 (most powerful)
AI_MODEL=anthropic.claude-3-sonnet-20240229-v1:0

# ===== Confluence Configuration =====
CONFLUENCE_URL=https://yourcompany.atlassian.net
CONFLUENCE_USERNAME=your.email@company.com
CONFLUENCE_API_TOKEN=your-api-token
CONFLUENCE_SPACE_KEY=TEAM

# ===== Optional Settings =====
# LOG_LEVEL=INFO
# OUTPUT_FORMAT=markdown
